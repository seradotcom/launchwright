{
  "name": "launchwright",
  "version": "0.2.0-dev.20",
  "private": true,
  "description": "Version-aware product release materials, built on the canonical Semwright Native SDK",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "exports": {
    ".": "./client/index.mjs",
    "./native": "./src/application.mjs"
  },
  "scripts": {
    "start": "node src/main.mjs serve",
    "init": "node src/main.mjs init",
    "doctor": "node src/main.mjs doctor",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:light": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:native-bundle": "node scripts/build-native-bundle.mjs",
    "verify": "node scripts/verify.mjs",
    "mcp:local": "node scripts/mcp-local.mjs",
    "deck:plan": "node scripts/deck-pdf.mjs plan",
    "deck:export": "node scripts/deck-pdf.mjs export",
    "test:deck": "node --test --test-concurrency=1 tests/deck-pdf.test.mjs",
    "demo:plan": "node scripts/interactive-demo.mjs plan",
    "demo:export": "node scripts/interactive-demo.mjs export",
    "test:demo": "node --test --test-concurrency=1 tests/interactive-demo.test.mjs",
    "store:plan": "node scripts/store-package.mjs plan",
    "store:export": "node scripts/store-package.mjs export",
    "test:store": "node --test --test-concurrency=1 tests/store-package.test.mjs",
    "docs:plan": "node scripts/static-docs.mjs plan",
    "docs:export": "node scripts/static-docs.mjs export",
    "test:docs": "node --test --test-concurrency=1 tests/static-docs.test.mjs",
    "video:plan": "node scripts/video-variants.mjs plan",
    "video:export": "node scripts/video-variants.mjs export",
    "video:smoke": "node scripts/video-variants-owned-smoke.mjs",
    "test:video": "node --test --test-concurrency=1 tests/video-variants.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@semwright/native-sdk": "file:vendor/semwright-native-sdk-1.0.0.tgz",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "pptxgenjs": "4.0.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
